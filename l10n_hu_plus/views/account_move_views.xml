<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form view inherit -->
    <record id="view_move_form_inherit"
            model="ir.ui.view"
    >
        <field name="name">l10n.hu.plus.view.move.form.inherit</field>
        <field name="inherit_id"
               ref="account.view_move_form"
        />
        <field name="model">account.move</field>
        <field name="priority">36</field>
        <field name="arch"
               type="xml"
        >
            <!-- HU+ banner -->
            <xpath expr="//div[1]"
                   position="before"
            >
                <div name="l10n_hu_plus_banner"
                     class="border font-weight-bold mb-2 p-1"
                     invisible="not l10n_hu_plus_enabled or not l10n_hu_banner_enabled"
                >
                    <div name="l10n_hu_banner_start"
                         class="d-inline ms-2"
                    >
                        <span name="hu_flag">
                            <img src="/l10n_hu_plus/static/description/hu_flag.png"
                                 alt="HU Flag"
                                 class="p-0"
                                 width="36px"
                            />
                        </span>
                        <span name="action_l10n_hu_plus_documentation">
                            <button name="action_l10n_hu_plus_documentation"
                                    class="btn-link"
                                    string="HU+"
                                    type="object"
                            />
                        </span>
                    </div>
                    <div name="l10n_hu_banner_center"
                         class="d-inline"
                    >
                        <span name="l10n_hu_proforma_sent"
                              class="ms-2 me-2"
                              invisible="not l10n_hu_proforma_date or not l10n_hu_proforma_name"
                        >
                            <field name="l10n_hu_proforma_name"
                                   readonly="1"
                                   string="Proforma"
                            />
                        </span>
                        <span name="l10n_hu_proforma_not_sent"
                              class="ms-2 me-2"
                              invisible="l10n_hu_proforma_date and l10n_hu_proforma_name"
                        >
                            <field name="l10n_hu_proforma_name"
                                   class="text-danger"
                                   readonly="1"
                                   string="Proforma"
                            />
                        </span>
                        <span name="l10n_hu_plus_tag"
                              class="ms-2 me-2"
                              groups="l10n_hu_plus.user_group"
                        >
                            <field name="l10n_hu_plus_tag"
                                   context="{'default_tag_type': 'account_move'}"
                                   nolabel="1"
                                   options="{'color_field': 'color'}"
                                   placeholder="Tags..."
                                   widget="many2many_tags"
                            />
                        </span>
                        <span name="l10n_hu_plus_notes"
                              class="ms-2 me-2"
                              groups="l10n_hu_plus.user_group"
                        >
                            <field name="l10n_hu_plus_notes"
                                   nolabel="1"
                                   placeholder="Notes..."
                                   style="min-width:200px;"
                            />
                        </span>
                    </div>
                    <div name="l10n_hu_banner_end"
                         class="d-inline float-end"
                    >
                        <span name="action_l10n_hu_quick_accounting"
                              class="ms-2"
                              groups="l10n_hu_plus.user_group"
                              invisible="state != 'draft'"
                        >
                            <button name="action_l10n_hu_quick_accounting"
                                    class="btn-link btn-sm"
                                    icon="fa-bolt"
                                    string="Accounting"
                                    type="object"
                            />
                        </span>
                        <div name="l10n_hu_banner_dropdown"
                             class="btn-group ms-2"
                        >
                            <a id="l10nHuDropdownMenuLink"
                               name="l10n_hu_banner_dropdown_button"
                               class="btn btn-secondary dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false"
                            >
                                Actions
                            </a>
                            <ul name="l10n_hu_banner_dropdown_items"
                                aria-labelledby="l10nHuDropdownMenuLink"
                                class="dropdown-menu dropdown-menu-end"
                                role="menu"
                            >
                                <li name="l10n_hu_send_proforma"
                                    invisible="state != 'draft' or not l10n_hu_proforma_sequence"
                                >
                                    <button name="action_l10n_hu_send_proforma"
                                            class="dropdown-item"
                                            icon="fa-send"
                                            string="Proforma Send"
                                            type="object"
                                    />
                                </li>
                                <li name="l10n_hu_send_proforma_divider"
                                    class="dropdown-divider"
                                    invisible="state != 'draft' or not l10n_hu_proforma_sequence"
                                />
                                <li name="l10n_hu_wizard_accounting"
                                    groups="l10n_hu_plus.user_group"
                                    invisible="state != 'draft'"
                                >
                                    <button name="action_l10n_hu_wizard_accounting"
                                            class="dropdown-item"
                                            icon="fa-magic"
                                            string="Accounting"
                                            type="object"
                                    />
                                </li>
                                <li name="l10n_hu_wizard_accounting_divider"
                                    class="dropdown-divider"
                                    groups="l10n_hu_plus.user_group"
                                    invisible="state != 'draft'"
                                />
                                <li name="l10n_hu_wizard_currency_exchange"
                                    groups="l10n_hu_plus.user_group"
                                    invisible="currency_id == company_currency_id"
                                >
                                    <button name="action_l10n_hu_wizard_currency_exchange"
                                            class="dropdown-item"
                                            icon="fa-calculator"
                                            string="Currency Exchange"
                                            type="object"
                                    />
                                </li>
                                <li name="l10n_hu_view_currency_rate"
                                    groups="l10n_hu_plus.user_group"
                                    invisible="currency_id == company_currency_id"
                                >
                                    <button name="action_l10n_hu_view_currency_rate"
                                            class="dropdown-item"
                                            icon="fa-area-chart"
                                            string="Currency Rates"
                                            type="object"
                                    />
                                </li>
                                <li name="l10n_hu_currency_divider"
                                    class="dropdown-divider"
                                    groups="l10n_hu_plus.user_group"
                                    invisible="currency_id == company_currency_id"
                                />
                                <li name="l10n_hu_plus_documentation">
                                    <button name="action_l10n_hu_plus_documentation"
                                            class="dropdown-item"
                                            icon="fa-info-circle"
                                            string="Documentation"
                                            type="object"
                                    />
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </xpath>
            <!-- HU+ fields -->
            <xpath expr="//page[@name='aml_tab']"
                   position="after"
            >
                <page name="l10n_hu_plus"
                      invisible="not l10n_hu_plus_enabled"
                      string="HU+"
                >
                    <group name="l10n_hu_plus">
                        <group name="l10n_hu_plus_1"
                               invisible="l10n_hu_journal_type not in ['purchase', 'sale']"
                        >
                            <!-- Document type -->
                            <field name="l10n_hu_document_type"
                                   options="{'no_create': True,}"
                                   readonly="state != 'draft' and not to_check"
                                   string="Document Type"
                            />
                            <!-- Original invoice -->
                            <label name="l10n_hu_original_invoice"
                                   for="l10n_hu_original_invoice_number"
                                   string="Original Invoice Number"
                            />
                            <div name="l10n_hu_original_invoice">
                                <field name="reversed_entry_id"
                                       invisible="not reversed_entry_id"
                                />
                                <field name="l10n_hu_original_invoice_number"
                                       class="oe_inline"
                                       invisible="reversed_entry_id"
                                       readonly="state != 'draft' and not to_check"
                                />
                                <button name="action_l10n_hu_view_original_invoice"
                                        class="oe_inline btn-sm btn-link"
                                        icon="fa-folder-open"
                                        invisible="reversed_entry_id or not l10n_hu_original_invoice_number"
                                        string="View"
                                        type="object"
                                />
                            </div>
                            <!-- Tags -->
                            <field name="l10n_hu_plus_tag"
                                   context="{'default_tag_type': 'account_move'}"
                                   groups="l10n_hu_plus.user_group"
                                   invisible="l10n_hu_banner_enabled"
                                   options="{'color_field': 'color'}"
                                   string="Tags"
                                   widget="many2many_tags"
                            />
                            <!-- Notes -->
                            <field name="l10n_hu_plus_notes"
                                   groups="l10n_hu_plus.user_group"
                                   invisible="l10n_hu_banner_enabled"
                                   string="Notes"
                            />
                        </group>
                        <group name="l10n_hu_plus_2"
                               invisible="l10n_hu_journal_type not in ['purchase', 'sale']"
                        >
                            <!-- VAT -->
                            <field name="l10n_hu_vat_date"
                                   readonly="state != 'draft' and not to_check"
                                   string="VAT Date"
                            />
                            <!-- Cash accounting -->
                            <field name="l10n_hu_cash_accounting"
                                   force_save="1"
                                   readonly="state != 'draft' and not to_check"
                                   string="Cash Accounting"
                            />
                        </group>
                        <!-- Delivery period -->
                        <group name="l10n_hu_delivery_period"
                               string="Period"
                        >
                            <label name="l10n_hu_delivery_period"
                                   for="l10n_hu_delivery_period_start"
                                   string="Delivery Period"
                            />
                            <div name="l10n_hu_delivery_period">
                                <field name="l10n_hu_delivery_period_start"
                                       class="oe_inline o_input_12ch"
                                       placeholder="Start date..."
                                       readonly="state != 'draft' and not to_check"
                                />
                                <span class="ps-2 pe-2">-</span>
                                <field name="l10n_hu_delivery_period_end"
                                       class="oe_inline o_input_12ch"
                                       placeholder="End date..."
                                       readonly="state != 'draft' and not to_check"
                                />
                                <field name="l10n_hu_delivery_period_summary"
                                       class="fst-italic text-muted"
                                       invisible="1"
                                />
                                <field name="l10n_hu_delivery_period_legal"
                                       class="fst-italic text-muted"
                                       invisible="l10n_hu_journal_type != 'sale' or l10n_hu_delivery_period_legal in [False, '']"
                                />
                            </div>
                            <label name="l10n_hu_delivery_period_actions"
                                   for="action_l10n_hu_refresh_delivery_period"
                                   invisible="state != 'draft' or l10n_hu_journal_type != 'sale' or not l10n_hu_delivery_period_start or not l10n_hu_delivery_period_end"
                                   string="Actions"
                            />
                            <div name="l10n_hu_delivery_period_actions"
                                 class="gap-2"
                                 invisible="state != 'draft' or l10n_hu_journal_type != 'sale' or not l10n_hu_delivery_period_start or not l10n_hu_delivery_period_end"
                            >
                                <button name="action_l10n_hu_refresh_delivery_period"
                                        class="btn-sm btn-link text-start"
                                        icon="fa-refresh"
                                        string="Update delivery period fields"
                                        type="object"
                                />
                            </div>
                        </group>
                        <!-- Currency -->
                        <group name="l10n_hu_plus_currency"
                               string="Currency"
                        >
                            <field name="l10n_hu_company_currency_name"
                                   invisible="1"
                            />
                            <label name="l10n_hu_accounting_rate"
                                   for="l10n_hu_currency_rate"
                                   string="Accounting Rate"
                            />
                            <div name="currency_exchange_ignored"
                                 class="fst-italic text-muted"
                                 invisible="currency_id != company_currency_id"
                            >
                                This document uses the company currency
                            </div>
                            <div name="l10n_hu_accounting_rate"
                                 invisible="currency_id == company_currency_id"
                            >
                                <field name="l10n_hu_currency_rate"
                                       class="oe_inline"
                                />
                                <field name="l10n_hu_currency_name"
                                       class="oe_inline ps-2 pe-2"
                                />
                                <field name="l10n_hu_currency_date"
                                       class="oe_inline"
                                />
                            </div>
                            <label name="l10n_hu_document_rate"
                                   for="l10n_hu_document_rate"
                                   string="Document Rate"
                            />
                            <div name="l10n_hu_document_rate">
                                <field name="l10n_hu_document_rate"
                                       class="oe_inline"
                                       readonly="(state != 'draft' and not to_check) or currency_id == company_currency_id"
                                />
                                <field name="l10n_hu_document_rate_difference"
                                       class="oe_inline ms-2 fst-italic text-muted"
                                       invisible="currency_id == company_currency_id"
                                />
                            </div>
                            <field name="l10n_hu_huf_rate"
                                   invisible="l10n_hu_company_currency_name == 'HUF'"
                                   string="HUF Rate"
                            />
                            <label name="l10n_hu_currency_actions"
                                   for="action_l10n_hu_view_currency_rate"
                                   invisible="l10n_hu_company_currency_name == 'HUF' and l10n_hu_currency_name == 'HUF'"
                                   string="Actions"
                            />
                            <div name="l10n_hu_currency_actions"
                                 class="gap-2"
                                 invisible="l10n_hu_company_currency_name == 'HUF' and l10n_hu_currency_name == 'HUF'"
                            >
                                <button name="action_l10n_hu_wizard_currency_exchange"
                                        class="btn-link btn-sm text-start"
                                        groups="l10n_hu_plus.user_group"
                                        icon="fa-calculator"
                                        invisible="state != 'draft' and not to_check"
                                        string="Currency Exchange"
                                        type="object"
                                />
                                <button name="action_l10n_hu_view_currency_rate"
                                        groups="l10n_hu_plus.user_group"
                                        class="btn-link btn-sm text-start"
                                        icon="fa-area-chart"
                                        string="Currency Rates"
                                        type="object"
                                />
                            </div>
                        </group>
                        <!-- Proforma -->
                        <group name="l10n_hu_plus_proforma"
                               invisible="l10n_hu_journal_type != 'sale' or not l10n_hu_proforma_sequence"
                               string="Proforma"
                        >
                            <field name="l10n_hu_proforma_name"
                                   readonly="state != 'draft' and not to_check"
                                   string="Proforma Name"
                            />
                            <field name="l10n_hu_proforma_date"
                                   readonly="state != 'draft' and not to_check"
                                   string="Proforma Date"
                            />
                            <label name="l10n_hu_proforma_actions"
                                   for="action_l10n_hu_send_proforma"
                                   string="Actions"
                            />
                            <div name="l10n_hu_proforma_actions"
                                 class="gap-2"
                            >
                                <button name="action_l10n_hu_send_proforma"
                                        class="btn-link btn-sm text-start"
                                        groups="l10n_hu_plus.user_group"
                                        icon="fa-send"
                                        invisible="state != 'draft' or not l10n_hu_proforma_sequence"
                                        string="Proforma Send"
                                        type="object"
                                />
                            </div>
                        </group>
                        <!-- Partner -->
                        <group name="l10n_hu_plus_partner"
                               invisible="l10n_hu_journal_type not in ['purchase', 'sale']"
                               string="Partner"
                        >
                            <field name="l10n_hu_fiscal_representative"
                                   invisible="l10n_hu_journal_type not in ['purchase', 'sale']"
                                   options="{'no_create': True,}"
                                   readonly="state != 'draft' and not to_check"
                                   string="Fiscal Representative"
                            />
                            <field name="l10n_hu_fiscal_representative_bank_account"
                                   domain="[('partner_id', '=', l10n_hu_fiscal_representative)]"
                                   invisible="l10n_hu_journal_type not in ['purchase', 'sale']"
                                   options="{'no_create': True,}"
                                   readonly="state != 'draft' and not to_check"
                                   string="Fiscal Representative Bank Account"
                            />
                            <field name="l10n_hu_company_partner"
                                   string="Company Partner"
                            />
                            <field name="l10n_hu_partner_country"
                                   string="Partner Country"
                            />
                        </group>
                        <!-- Journal -->
                        <group name="l10n_hu_plus_journal"
                               string="Journal"
                        >
                            <field name="l10n_hu_plus_enabled"
                                   string="HU+"
                            />
                            <field name="l10n_hu_banner_enabled"
                                   string="Banner"
                            />
                            <field name="l10n_hu_proforma_sequence"
                                   invisible="not l10n_hu_proforma_sequence"
                                   string="Proforma Sequence"
                            />
                            <field name="l10n_hu_journal_type"
                                   string="Journal Type"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <!-- List view inherit  -->
    <record id="view_invoice_tree_inherit"
            model="ir.ui.view"
    >
        <field name="name">l10n.hu.account.view.invoice.tree.inherit</field>
        <field name="inherit_id"
               ref="account.view_invoice_tree"
        />
        <field name="model">account.move</field>
        <field name="priority">36</field>
        <field name="arch"
               type="xml"
        >
            <!-- Add proforma -->
            <field name="name"
                   position="after"
            >
                <field name="l10n_hu_proforma_name"
                       optional="hide"
                       readonly="state in ['cancel', 'posted']"
                       string="Proforma Name"
                />
            </field>
            <!-- Add delivery date -->
            <field name="date"
                   position="after"
            >
                <field name="delivery_date"
                       optional="hide"
                       readonly="state in ['cancel', 'posted']"
                       string="Delivery Date"
                />
            </field>
            <!-- Trade position -->
            <xpath expr="//field[@name='date']"
                   position="before"
            >
                <field name="l10n_hu_partner_country"
                       optional="hide"
                />
                <field name="l10n_hu_trade_position"
                       optional="hide"
                       string="Trade Position"
                />
            </xpath>
            <!-- VAT date -->
            <xpath expr="//field[@name='date']"
                   position="after"
            >
                <field name="l10n_hu_vat_date"
                       optional="hide"
                       string="VAT Date"
                />
            </xpath>
            <!-- Tag and notes -->
            <xpath expr="//field[@name='state']"
                   position="before"
            >
                <field name="l10n_hu_plus_tag"
                       optional="hide"
                       options="{'color_field': 'color'}"
                       string="HU+ Tag"
                       widget="many2many_tags"
                />
                <field name="l10n_hu_plus_notes"
                       optional="hide"
                       string="HU+ Notes"
                />
            </xpath>
        </field>
    </record>
    <!-- Search view inherit  -->
    <record id="view_account_invoice_filter_inherit"
            model="ir.ui.view"
    >
        <field name="name">l10n.hu.account.view.account.invoice.filter.inherit</field>
        <field name="inherit_id"
               ref="account.view_account_invoice_filter"
        />
        <field name="model">account.move</field>
        <field name="priority">36</field>
        <field name="arch"
               type="xml"
        >
            <!-- Field -->
            <xpath expr="//field[@name='name'][1]"
                   position="attributes"
            >
                <attribute name="filter_domain">['|', '|' , '|', '|', '|',
                    ('name', 'ilike', self), ('invoice_origin', 'ilike', self),
                    ('ref', 'ilike', self), ('payment_reference', 'ilike', self),
                    ('partner_id', 'child_of', self),('l10n_hu_proforma_name', 'ilike', self)]
                </attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']"
                   position="before"
            >
                <field name="l10n_hu_proforma_name"
                       string="Proforma"
                />
                <field name="l10n_hu_plus_tag"
                       string="HU+ Tag"
                />
                <field name="l10n_hu_plus_notes"
                       string="HU+ Notes"
                />
            </xpath>
            <!-- Filter -->
            <xpath expr="//filter[@name='invoice_date']"
                   position="after"
            >
                <filter name="delivery_date_filter"
                        date="delivery_date"
                        string="Delivery Date"
                />
            </xpath>
            <xpath expr="//filter[@name='due_date']"
                   position="after"
            >
                <separator/>
                <filter name="l10n_hu_vat_date_filter"
                        date="l10n_hu_vat_date"
                        string="VAT Date"
                />
                <filter name="l10n_hu_proforma_date_filter"
                        date="l10n_hu_proforma_date"
                        string="Proforma Date"
                />
                <separator/>
                <filter name="l10n_hu_plus_tag_filter"
                        domain="[('l10n_hu_plus_tag', '!=', False)]"
                        string="HU+ Tags"
                />
                <filter name="l10n_hu_plus_notes_filter"
                        domain="[('l10n_hu_plus_notes', '!=', False)]"
                        string="HU+ Notes"
                />
                <filter name="l10n_hu_proforma_sent_filter"
                        domain="[('l10n_hu_proforma_date', '!=', False), ('l10n_hu_proforma_name', '!=', False)]"
                        string="Proforma Sent"
                />
                <separator/>
                <filter name="l10n_hu_trade_position_domestic_filter"
                        domain="[('l10n_hu_trade_position', '=', 'domestic')]"
                        string="Domestic"
                />
                <filter name="l10n_hu_trade_position_eu_filter"
                        domain="[('l10n_hu_trade_position', '=', 'eu')]"
                        string="EU"
                />
                <filter name="l10n_hu_trade_position_other_filter"
                        domain="[('l10n_hu_trade_position', '=', 'other')]"
                        string="Other"
                />
                <filter name="l10n_hu_trade_position_none_filter"
                        domain="[('l10n_hu_trade_position', '=', False)]"
                        string="No Trade Position"
                />
            </xpath>
            <!-- Filter group by -->
            <xpath expr="//filter[@name='invoicedate']"
                   position="after"
            >
                <filter name="delivery_date_filter_group_by"
                        context="{'group_by': 'delivery_date'}"
                        string="Delivery Date"
                />
            </xpath>
            <xpath expr="//filter[@name='group_by_sequence_prefix']"
                   position="after"
            >
                <separator/>
                <filter name="l10n_hu_plus_tag_filter_group_by"
                        context="{'group_by': 'l10n_hu_plus_tag'}"
                        string="HU+ Tag"
                />
                <filter name="l10n_hu_vat_date_filter_group_by"
                        context="{'group_by': 'l10n_hu_vat_date'}"
                        string="VAT Date"
                />
                <filter name="l10n_hu_proforma_date_filter_group_by"
                        context="{'group_by': 'l10n_hu_proforma_date'}"
                        string="Proforma Date"
                />
                <filter name="l10n_hu_partner_country_filter_group_by"
                        context="{'group_by': 'l10n_hu_partner_country'}"
                        string="Partner Country"
                />
                <filter name="l10n_hu_trade_position_filter_group_by"
                        context="{'group_by': 'l10n_hu_trade_position'}"
                        string="Trade Position"
                />
                <filter name="partner_id_filter_group_by"
                        context="{'group_by': 'partner_id'}"
                        string="Partner"
                />
            </xpath>
        </field>
    </record>
</odoo>
