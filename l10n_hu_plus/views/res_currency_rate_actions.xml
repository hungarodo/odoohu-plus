<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Window action -->
    <record id="res_currency_rate_action" model="ir.actions.act_window">
        <field name="name">Currency Rates</field>
        <field name="context">{'search_default_currency_id_filter_group_by': 1}</field>
        <field name="res_model">res.currency.rate</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Window action list view -->
    <record id="res_currency_rate_action_list" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="res_currency_rate_action"/>
        <field name="sequence">8</field>
        <field name="view_id" ref="base.view_currency_rate_tree"/>
        <field name="view_mode">list</field>
    </record>
    <!-- Window action form view -->
    <record id="res_currency_rate_action_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="res_currency_rate_action"/>
        <field name="sequence">16</field>
        <field name="view_id" ref="base.view_currency_rate_form"/>
        <field name="view_mode">form</field>
    </record>
</odoo>
